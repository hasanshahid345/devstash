# Used by Prisma CLI for migrations and schema operations.
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Used by Prisma Client at runtime with Neon pooling.
DATABASE_URL="postgres://USER:PASSWORD@HOST-Pooler:5432/DB?sslmode=require"

# Toggle Resend-based email verification on or off.
AUTH_EMAIL_VERIFICATION_ENABLED="true"

# Auth.js / NextAuth.
AUTH_SECRET="generate-a-secret-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Upstash Redis for auth rate limiting.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# GitHub OAuth app credentials.
# GitHub Authorization callback URL for local development:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="github-oauth-client-id"
AUTH_GITHUB_SECRET="github-oauth-client-secret"
